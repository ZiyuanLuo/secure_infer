#include "codec.h"
#include <atomic>
extern __global__ __aicpu__ uint32_t entropy_restore(void*);
namespace { alignas(64) EntropyArgs descriptors[4096]; std::atomic<uint32_t> next{0}; }
extern "C" __attribute__((visibility("default"))) int entropy_restore_do(
 void* stream,void* input,void* output,void* scratch,void* status,
 uint32_t tokens,uint32_t channels,uint32_t compressed_bytes) {
 if(!stream||!input||!output||!scratch||!status||!tokens||!channels||!compressed_bytes)return -1;
 auto& a=descriptors[next.fetch_add(1)%4096];
 a={reinterpret_cast<uint64_t>(input),reinterpret_cast<uint64_t>(output),
    reinterpret_cast<uint64_t>(scratch),reinterpret_cast<uint64_t>(status),tokens,channels,compressed_bytes,0};
 entropy_restore<<<1,nullptr,stream>>>(&a,sizeof(a));
 return 0;
}
