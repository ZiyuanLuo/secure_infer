#include "aicpu_api.h"
#include "codec.h"
#include <arm_neon.h>
#include "miniz/miniz_tinfl.c"
#include <string.h>
#define LZ4_FREESTANDING 1
#define LZ4_memcpy memcpy
#define LZ4_memmove memmove
#define LZ4_memset memset
#include "lz4/lz4.c"

// Entropy restoration and BF16 reconstruction share one AICPU launch.
__global__ __aicpu__ uint32_t entropy_restore(void* opaque) {
 auto* a = reinterpret_cast<EntropyArgs*>(opaque);
 auto* status = reinterpret_cast<uint32_t*>(a->status);
 if (!status || *status != 1 || !a->input || !a->scratch || !a->output ||
     !a->tokens || !a->channels || a->channels % 8) return 2;
 const auto* input = reinterpret_cast<const uint8_t*>(a->input);
 const auto* scales = reinterpret_cast<const float*>(input);
 auto* symbols = reinterpret_cast<uint8_t*>(a->scratch);
 auto* out = reinterpret_cast<uint16_t*>(a->output);
 size_t expected = uint64_t(a->tokens)*a->channels;
 const auto* encoded = input+a->tokens*sizeof(float);
 size_t length = 0;
 if (a->compressed_bytes & 0x80000000U) {
   symbols = const_cast<uint8_t*>(encoded);
   length = expected;
 } else if (a->compressed_bytes & 0x40000000U) {
   int rc = LZ4_decompress_safe(reinterpret_cast<const char*>(encoded),
       reinterpret_cast<char*>(symbols), a->compressed_bytes & 0x1fffffffU, expected);
   length = rc < 0 ? 0 : size_t(rc);
 } else {
   length = tinfl_decompress_mem_to_mem(symbols, expected, encoded,
       a->compressed_bytes, TINFL_FLAG_PARSE_ZLIB_HEADER);
 }
 if (length != expected) { *status = 2; return 3; }
 for (uint32_t t=0; t<a->tokens; ++t) {
   const float32x4_t scale = vdupq_n_f32(scales[t]);
   for (uint32_t c=0; c<a->channels; c+=8) {
     uint64_t i=uint64_t(t)*a->channels+c;
     uint8x8_t codes;
     if (a->compressed_bytes & 0x20000000U) {
       // Undo a 128-symbol bit transpose and fuse reconstruction into this pass.
       uint64_t base=(i/128)*128, group=(i%128)/8, word=0;
       for (uint32_t bit=0;bit<8;++bit) word|=uint64_t(symbols[base+bit*16+group])<<(8*bit);
       uint64_t tmp=(word^(word>>7))&0x00AA00AA00AA00AAULL;
       word^=tmp^(tmp<<7);
       tmp=(word^(word>>14))&0x0000CCCC0000CCCCULL;
       word^=tmp^(tmp<<14);
       tmp=(word^(word>>28))&0x00000000F0F0F0F0ULL;
       word^=tmp^(tmp<<28);
       codes=vld1_u8(reinterpret_cast<const uint8_t*>(&word));
     } else codes=vld1_u8(symbols+i);
     uint16x8_t values=vmovl_u8(codes);
     int32x4_t low=vsubq_s32(vreinterpretq_s32_u32(vmovl_u16(vget_low_u16(values))),vdupq_n_s32(127));
     int32x4_t high=vsubq_s32(vreinterpretq_s32_u32(vmovl_u16(vget_high_u16(values))),vdupq_n_s32(127));
     uint32x4_t lo=vreinterpretq_u32_f32(vmulq_f32(vcvtq_f32_s32(low),scale));
     uint32x4_t hi=vreinterpretq_u32_f32(vmulq_f32(vcvtq_f32_s32(high),scale));
     // Round to nearest even when restoring BF16, including subnormals.
     lo=vaddq_u32(lo,vaddq_u32(vdupq_n_u32(0x7fff),vandq_u32(vshrq_n_u32(lo,16),vdupq_n_u32(1))));
     hi=vaddq_u32(hi,vaddq_u32(vdupq_n_u32(0x7fff),vandq_u32(vshrq_n_u32(hi,16),vdupq_n_u32(1))));
     vst1q_u16(out+i,vcombine_u16(vshrn_n_u32(lo,16),vshrn_n_u32(hi,16)));
   }
 }
 return 0;
}
