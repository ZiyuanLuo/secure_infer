#include "aicpu_api.h"
#include <fcntl.h>
#include <unistd.h>
#include <stdint.h>
#include "monocypher/monocypher.c"

struct EcdhArgs { uint64_t host_public, challenge, device_key, device_public, proof, status; };

__global__ __aicpu__ uint32_t secure_infer_device_key_agreement(void *opaque)
{
    const auto *args = static_cast<const EcdhArgs *>(opaque);
    auto *status = reinterpret_cast<int32_t *>(args->status);
    const auto *host_public = reinterpret_cast<const uint8_t *>(args->host_public);
    const auto *challenge = reinterpret_cast<const uint8_t *>(args->challenge);
    auto *device_key = reinterpret_cast<uint8_t *>(args->device_key);
    auto *device_public = reinterpret_cast<uint8_t *>(args->device_public);
    auto *proof = reinterpret_cast<uint8_t *>(args->proof);
    uint8_t secret[32] = {}, shared[32] = {};
    static const uint8_t info[] = "SecureInfer X25519 BLAKE2b test v1";
    *status = 1;
    int fd = open("/dev/urandom", O_RDONLY | O_NONBLOCK);
    if (fd < 0) return 0;
    size_t done = 0;
    while (done < sizeof(secret)) {
        const auto n = read(fd, secret + done, sizeof(secret) - done);
        if (n <= 0) { close(fd); crypto_wipe(secret, sizeof(secret)); return 0; }
        done += static_cast<size_t>(n);
    }
    close(fd);
    *status = 2;
    crypto_x25519_public_key(device_public, secret);
    crypto_x25519(shared, secret, host_public);
    unsigned nonzero = 0;
    for (auto byte : shared) nonzero |= byte;
    if (!nonzero) { crypto_wipe(secret, sizeof(secret)); return 0; }
    *status = 3;
    crypto_blake2b_ctx ctx;
    crypto_blake2b_keyed_init(&ctx, 16, shared, sizeof(shared));
    crypto_blake2b_update(&ctx, info, sizeof(info) - 1);
    crypto_blake2b_update(&ctx, host_public, 32);
    crypto_blake2b_update(&ctx, device_public, 32);
    crypto_blake2b_update(&ctx, challenge, 32);
    crypto_blake2b_final(&ctx, device_key);
    crypto_blake2b_keyed(proof, 32, device_key, 16, challenge, 32);
    crypto_wipe(secret, sizeof(secret));
    crypto_wipe(shared, sizeof(shared));
    *status = 0;
    return 0;
}
