// Batch only the independent authenticated releases.  This is deliberately
// separate from the single-record ABI so old serving images remain usable and
// the caller can retain the exact per-slice security/accounting path.
extern "C" __attribute__((visibility("default"))) int
secure_infer_aicpu_gcm_verify_xor_batch_do(
    void* stream, void* key, void* hash_subkey, void* const* ciphertexts,
    void* const* expected_tags, void* const* keystreams,
    void* const* plaintext_outputs, void* const* status_outputs,
    void* const* aads, uint64_t bytes, uint64_t aad_bytes,
    const uint32_t* iv_words, uint32_t count)
{
    if (stream == nullptr || key == nullptr || hash_subkey == nullptr ||
        ciphertexts == nullptr || expected_tags == nullptr ||
        keystreams == nullptr || plaintext_outputs == nullptr ||
        status_outputs == nullptr || iv_words == nullptr || bytes == 0 ||
        (aad_bytes != 0 && aads == nullptr) ||
        count == 0 || count > PIPE_GCM_VERIFY_XOR_BATCH_MAX) {
        return -1;
    }
    PipeGcmVerifyXorBatchArgs& args = g_gcm_verify_xor_batch_args[
        g_next_gcm_verify_xor_batch_arg.fetch_add(1, std::memory_order_relaxed) %
        kArgSlots];
    args = {};
    args.key = reinterpret_cast<uint64_t>(key);
    args.hash_subkey = reinterpret_cast<uint64_t>(hash_subkey);
    args.bytes = bytes;
    args.aad_bytes = aad_bytes;
    args.count = count;
    for (uint32_t index = 0; index < count; ++index) {
        if (ciphertexts[index] == nullptr || expected_tags[index] == nullptr ||
            keystreams[index] == nullptr || plaintext_outputs[index] == nullptr ||
            status_outputs[index] == nullptr) {
            return -1;
        }
        args.ciphertexts[index] = reinterpret_cast<uint64_t>(ciphertexts[index]);
        args.expected_tags[index] = reinterpret_cast<uint64_t>(expected_tags[index]);
        args.keystreams[index] = reinterpret_cast<uint64_t>(keystreams[index]);
        args.plaintext_outputs[index] = reinterpret_cast<uint64_t>(plaintext_outputs[index]);
        args.status_outputs[index] = reinterpret_cast<uint64_t>(status_outputs[index]);
        if (aad_bytes != 0) {
            if (aads[index] == nullptr) return -1;
            args.aad[index] = reinterpret_cast<uint64_t>(aads[index]);
        }
        for (uint32_t word = 0; word < 4; ++word) {
            args.iv_words[index][word] = iv_words[index * 4 + word];
        }
    }
    secure_infer_gcm_verify_xor_batch<<<1, nullptr, stream>>>(&args, sizeof(args));
    return 0;
}

// Profiling-only control for attributing the online authenticated-release
// time.  It deliberately preserves the same AICPU launch ABI, ciphertext and
// keystream reads, output write, status publication, stream ordering, and D2D
// release as the production fused kernel, but assumes a valid tag and omits
// GHASH/tag verification.  SecureInfer resolves this symbol only when an explicit
// diagnostic environment variable is set and a precise-profile marker is
// active; it is never a production security path.
extern "C" __attribute__((visibility("default"))) int
secure_infer_aicpu_gcm_xor_only_do(
    void* stream, void* ciphertext, void* key, void* hash_subkey,
    void* expected_tag, void* keystream, void* plaintext_output,
    void* status_output, uint64_t bytes, uint32_t iv_word0,
    uint32_t iv_word1, uint32_t iv_word2, uint32_t iv_word3)
{
    if (stream == nullptr || ciphertext == nullptr || key == nullptr ||
        hash_subkey == nullptr || expected_tag == nullptr ||
        keystream == nullptr || plaintext_output == nullptr ||
        status_output == nullptr || bytes == 0) {
        return -1;
    }
    PipeGcmVerifyXorArgs& args = g_gcm_xor_only_args[
        g_next_gcm_xor_only_arg.fetch_add(1, std::memory_order_relaxed) %
        kArgSlots];
    args = {
        reinterpret_cast<uint64_t>(ciphertext),
        reinterpret_cast<uint64_t>(key),
        reinterpret_cast<uint64_t>(hash_subkey),
        reinterpret_cast<uint64_t>(expected_tag),
        reinterpret_cast<uint64_t>(keystream),
        reinterpret_cast<uint64_t>(plaintext_output),
        reinterpret_cast<uint64_t>(status_output),
        bytes,
        {iv_word0, iv_word1, iv_word2, iv_word3},
    };
    secure_infer_gcm_xor_only<<<1, nullptr, stream>>>(&args, sizeof(args));
    return 0;
}
