#include "acl/acl.h"
#include "ghash_shared.h"

#include <atomic>
#include <stdint.h>

extern __global__ __aicpu__ uint32_t secure_infer_ghash(void *args);
extern __global__ __aicpu__ uint32_t secure_infer_auth_gate(void *args);
extern __global__ __aicpu__ uint32_t secure_infer_aes_ctr(void *args);
extern __global__ __aicpu__ uint32_t secure_infer_aes_keystream(void *args);
extern __global__ __aicpu__ uint32_t secure_infer_aes_keystream_batch(void *args);
extern __global__ __aicpu__ uint32_t secure_infer_gcm_decrypt_verify(void *args);
extern __global__ __aicpu__ uint32_t secure_infer_gcm_encrypt_tag(void *args);
extern __global__ __aicpu__ uint32_t secure_infer_gcm_verify_xor(void *args);
extern __global__ __aicpu__ uint32_t secure_infer_gcm_verify_only(void *args);
extern __global__ __aicpu__ uint32_t secure_infer_gcm_verify_xor_batch(void *args);
extern __global__ __aicpu__ uint32_t secure_infer_gcm_xor_only(void *args);

namespace {

// The custom AICPU launch is asynchronous: the runtime may consume the
// argument record after this C wrapper returns. A stack-local record therefore
// becomes use-after-return under a serving workload even though a synchronous
// microbenchmark appears correct. Keep a bounded, allocation-free argument
// slab alive for the process lifetime. The data plane bounds in-flight work to
// A 4-GiB admission window can contain three 8K D2H jobs (15,120 calls) while
// one 5,040-slice H2D reload is also active.  Keep ample headroom so argument
// records are never overwritten before the asynchronous runtime consumes
// them, even with GHASH, AES and auth-gate queues progressing at different
// rates.
constexpr uint32_t kArgSlots = 65536;
alignas(64) PipeGhashArgs g_ghash_args[kArgSlots];
alignas(64) PipeAuthGateArgs g_gate_args[kArgSlots];
alignas(64) PipeAesCtrArgs g_aes_args[kArgSlots];
alignas(64) PipeAesKeystreamArgs g_keystream_args[kArgSlots];
alignas(64) PipeAesKeystreamBatchArgs g_keystream_batch_args[kArgSlots];
alignas(64) PipeGcmDecryptVerifyArgs g_gcm_decrypt_verify_args[kArgSlots];
alignas(64) PipeGcmEncryptTagArgs g_gcm_encrypt_tag_args[kArgSlots];
alignas(64) PipeGcmVerifyXorArgs g_gcm_verify_xor_args[kArgSlots];
alignas(64) PipeGcmVerifyArgs g_gcm_verify_only_args[kArgSlots];
alignas(64) PipeGcmVerifyXorBatchArgs g_gcm_verify_xor_batch_args[kArgSlots];
alignas(64) PipeGcmVerifyXorArgs g_gcm_xor_only_args[kArgSlots];
std::atomic<uint32_t> g_next_ghash_arg{0};
std::atomic<uint32_t> g_next_gate_arg{0};
std::atomic<uint32_t> g_next_aes_arg{0};
std::atomic<uint32_t> g_next_keystream_arg{0};
std::atomic<uint32_t> g_next_keystream_batch_arg{0};
std::atomic<uint32_t> g_next_gcm_decrypt_verify_arg{0};
std::atomic<uint32_t> g_next_gcm_encrypt_tag_arg{0};
std::atomic<uint32_t> g_next_gcm_verify_xor_arg{0};
std::atomic<uint32_t> g_next_gcm_verify_only_arg{0};
std::atomic<uint32_t> g_next_gcm_verify_xor_batch_arg{0};
std::atomic<uint32_t> g_next_gcm_xor_only_arg{0};

}  // namespace

// Reusable asynchronous launcher for the LD_PRELOAD data plane. All pointers
// are device addresses. The operation is ordered on the supplied ACL stream.
extern "C" __attribute__((visibility("default"))) int
secure_infer_aicpu_ghash_do(
    void* stream,
    void* input,
    void* hash_subkey,
    void* output,
    void* aad,
    void* tag_mask,
    void* expected_tag,
    void* keystream,
    void* plaintext_output,
    void* status_output,
    uint64_t input_bytes,
    uint64_t aad_bytes,
    uint32_t flags)
{
    if (stream == nullptr || input == nullptr || hash_subkey == nullptr ||
        output == nullptr || input_bytes == 0) {
        return -1;
    }
    PipeGhashArgs& args = g_ghash_args[
        g_next_ghash_arg.fetch_add(1, std::memory_order_relaxed) % kArgSlots];
    args = {
        reinterpret_cast<uint64_t>(input),
        reinterpret_cast<uint64_t>(hash_subkey),
        reinterpret_cast<uint64_t>(output),
        reinterpret_cast<uint64_t>(aad),
        reinterpret_cast<uint64_t>(tag_mask),
        reinterpret_cast<uint64_t>(expected_tag),
        reinterpret_cast<uint64_t>(keystream),
        reinterpret_cast<uint64_t>(plaintext_output),
        reinterpret_cast<uint64_t>(status_output),
        input_bytes,
        aad_bytes,
        1,
        flags,
    };
    secure_infer_ghash<<<1, nullptr, stream>>>(&args, sizeof(args));
    return 0;
}

extern "C" __attribute__((visibility("default"))) int
secure_infer_aicpu_auth_gate_do(void* stream, void* data, void* status,
                          uint64_t bytes)
{
    if (stream == nullptr || data == nullptr || status == nullptr || bytes == 0) {
        return -1;
    }
    PipeAuthGateArgs& args = g_gate_args[
        g_next_gate_arg.fetch_add(1, std::memory_order_relaxed) % kArgSlots];
    args = {
        reinterpret_cast<uint64_t>(data),
        reinterpret_cast<uint64_t>(status),
        bytes,
    };
    secure_infer_auth_gate<<<1, nullptr, stream>>>(&args, sizeof(args));
    return 0;
}

extern "C" __attribute__((visibility("default"))) int
secure_infer_aicpu_aes_ctr_do(
    void* stream, void* input, void* key, void* output, uint64_t bytes,
    uint32_t iv_word0, uint32_t iv_word1,
    uint32_t iv_word2, uint32_t iv_word3)
{
    if (stream == nullptr || input == nullptr || key == nullptr ||
        output == nullptr || bytes == 0) {
        return -1;
    }
    PipeAesCtrArgs& args = g_aes_args[
        g_next_aes_arg.fetch_add(1, std::memory_order_relaxed) % kArgSlots];
    args = {
        reinterpret_cast<uint64_t>(input),
        reinterpret_cast<uint64_t>(key),
        reinterpret_cast<uint64_t>(output),
        bytes,
        {iv_word0, iv_word1, iv_word2, iv_word3},
    };
    secure_infer_aes_ctr<<<1, nullptr, stream>>>(&args, sizeof(args));
    return 0;
}

// Asynchronous AES-CTR key-stream generation for speculative background
// prefetch.  Unlike secure_infer_aicpu_aes_ctr_do, this path does not read a
// payload and does not perform a payload XOR.
extern "C" __attribute__((visibility("default"))) int
secure_infer_aicpu_keystream_do(
    void* stream, void* key, void* output, uint64_t bytes,
    uint32_t iv_word0, uint32_t iv_word1,
    uint32_t iv_word2, uint32_t iv_word3)
{
    if (stream == nullptr || key == nullptr || output == nullptr || bytes == 0) {
        return -1;
    }
    PipeAesKeystreamArgs& args = g_keystream_args[
        g_next_keystream_arg.fetch_add(1, std::memory_order_relaxed) % kArgSlots];
    args = {
        reinterpret_cast<uint64_t>(key),
        reinterpret_cast<uint64_t>(output),
        bytes,
        {iv_word0, iv_word1, iv_word2, iv_word3},
    };
    secure_infer_aes_keystream<<<1, nullptr, stream>>>(&args, sizeof(args));
    return 0;
}

// The caller owns each output buffer and passes host-resident pointer/IV
// arrays.  Copy them into the persistent argument slab before launching: the
// runtime may read the descriptor after this wrapper returns.
extern "C" __attribute__((visibility("default"))) int
secure_infer_aicpu_keystream_batch_do(
    void* stream, void* key, void* const* outputs, const uint32_t* iv_words,
    uint64_t bytes, uint32_t count)
{
    if (stream == nullptr || key == nullptr || outputs == nullptr ||
        iv_words == nullptr || bytes == 0 || count == 0 ||
        count > PIPE_AES_KEYSTREAM_BATCH_MAX) {
        return -1;
    }
    PipeAesKeystreamBatchArgs& args = g_keystream_batch_args[
        g_next_keystream_batch_arg.fetch_add(1, std::memory_order_relaxed) %
        kArgSlots];
    args = {};
    args.key = reinterpret_cast<uint64_t>(key);
    args.bytes = bytes;
    args.count = count;
    for (uint32_t index = 0; index < count; ++index) {
        if (outputs[index] == nullptr) return -1;
        args.outputs[index] = reinterpret_cast<uint64_t>(outputs[index]);
        for (uint32_t word = 0; word < 4; ++word) {
            args.iv_words[index][word] = iv_words[index * 4 + word];
        }
    }
    secure_infer_aes_keystream_batch<<<1, nullptr, stream>>>(&args, sizeof(args));
    return 0;
}

// Fused authenticated H2D release.  This wrapper has a dedicated argument
// slab because the asynchronous AICPU runtime may read it after return.
extern "C" __attribute__((visibility("default"))) int
secure_infer_aicpu_gcm_decrypt_verify_do(
    void* stream, void* ciphertext, void* key, void* hash_subkey,
    void* expected_tag, void* plaintext_output, void* status_output,
    uint64_t bytes, uint32_t iv_word0, uint32_t iv_word1,
    uint32_t iv_word2, uint32_t iv_word3)
{
    if (stream == nullptr || ciphertext == nullptr || key == nullptr ||
        hash_subkey == nullptr || expected_tag == nullptr ||
        plaintext_output == nullptr || status_output == nullptr || bytes == 0) {
        return -1;
    }
    PipeGcmDecryptVerifyArgs& args = g_gcm_decrypt_verify_args[
        g_next_gcm_decrypt_verify_arg.fetch_add(1, std::memory_order_relaxed) %
        kArgSlots];
    args = {
        reinterpret_cast<uint64_t>(ciphertext),
        reinterpret_cast<uint64_t>(key),
        reinterpret_cast<uint64_t>(hash_subkey),
        reinterpret_cast<uint64_t>(expected_tag),
        reinterpret_cast<uint64_t>(plaintext_output),
        reinterpret_cast<uint64_t>(status_output),
        bytes,
        {iv_word0, iv_word1, iv_word2, iv_word3},
    };
    secure_infer_gcm_decrypt_verify<<<1, nullptr, stream>>>(&args, sizeof(args));
    return 0;
}

// AAD-capable variant.  Keep this as a new symbol so an older serving
// process can still load an image built with the legacy ABI.
extern "C" __attribute__((visibility("default"))) int
secure_infer_aicpu_gcm_decrypt_verify_aad_do(
    void* stream, void* ciphertext, void* key, void* hash_subkey,
    void* expected_tag, void* plaintext_output, void* status_output,
    uint64_t bytes, uint32_t iv_word0, uint32_t iv_word1,
    uint32_t iv_word2, uint32_t iv_word3, void* aad, uint64_t aad_bytes)
{
    if (stream == nullptr || ciphertext == nullptr || key == nullptr ||
        hash_subkey == nullptr || expected_tag == nullptr ||
        plaintext_output == nullptr || status_output == nullptr || bytes == 0 ||
        (aad_bytes != 0 && aad == nullptr)) {
        return -1;
    }
    PipeGcmDecryptVerifyArgs& args = g_gcm_decrypt_verify_args[
        g_next_gcm_decrypt_verify_arg.fetch_add(1, std::memory_order_relaxed) %
        kArgSlots];
    args = {
        reinterpret_cast<uint64_t>(ciphertext),
        reinterpret_cast<uint64_t>(key),
        reinterpret_cast<uint64_t>(hash_subkey),
        reinterpret_cast<uint64_t>(expected_tag),
        reinterpret_cast<uint64_t>(plaintext_output),
        reinterpret_cast<uint64_t>(status_output),
        bytes,
        {iv_word0, iv_word1, iv_word2, iv_word3},
        reinterpret_cast<uint64_t>(aad),
        aad_bytes,
    };
    secure_infer_gcm_decrypt_verify<<<1, nullptr, stream>>>(&args, sizeof(args));
    return 0;
}

// Fused D2H AES-CTR encryption plus GCM tag generation.  The tag is copied to
// host memory only after this stream reaches the existing D2H copy event.
extern "C" __attribute__((visibility("default"))) int
secure_infer_aicpu_gcm_encrypt_tag_do(
    void* stream, void* plaintext, void* key, void* hash_subkey,
    void* ciphertext_output, void* tag_output, uint64_t bytes,
    uint32_t iv_word0, uint32_t iv_word1, uint32_t iv_word2,
    uint32_t iv_word3, void* aad, uint64_t aad_bytes)
{
    if (stream == nullptr || plaintext == nullptr || key == nullptr ||
        hash_subkey == nullptr || ciphertext_output == nullptr ||
        tag_output == nullptr || bytes == 0 ||
        (aad_bytes != 0 && aad == nullptr)) {
        return -1;
    }
    PipeGcmEncryptTagArgs& args = g_gcm_encrypt_tag_args[
        g_next_gcm_encrypt_tag_arg.fetch_add(1, std::memory_order_relaxed) %
        kArgSlots];
    args = {
        reinterpret_cast<uint64_t>(plaintext),
        reinterpret_cast<uint64_t>(key),
        reinterpret_cast<uint64_t>(hash_subkey),
        reinterpret_cast<uint64_t>(ciphertext_output),
        reinterpret_cast<uint64_t>(tag_output),
        bytes,
        {iv_word0, iv_word1, iv_word2, iv_word3},
        reinterpret_cast<uint64_t>(aad),
        aad_bytes,
    };
    secure_infer_gcm_encrypt_tag<<<1, nullptr, stream>>>(&args, sizeof(args));
    return 0;
}

